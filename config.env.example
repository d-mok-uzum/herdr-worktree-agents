# Worktree Agents settings. Copy to the plugin config dir as config.env:
#   cp config.env.example "$(herdr plugin config-dir minhtran.worktrees)/config.env"
# The panel and hooks read it on every run; it supplies the initial width for new boards.

# Initial panel width in columns. Manual panel resizing is saved and synchronized to every board.
WORKTREES_WIDTH=38

# Auto-open only in repos with at least this many checkouts (main + linked worktrees).
WORKTREES_MIN=2

# Seconds between PR/CI refreshes (one GitHub GraphQL call, shared by every panel).
WORKTREES_PR_TTL=60

# Seconds between git scans (dirty files, ahead/behind, last commit).
WORKTREES_GIT_EVERY=10

# GitHub CLI used for GitHub PR/CI. Default: /usr/bin/gh if present, else `gh` on PATH.
# WORKTREES_GH=/opt/homebrew/bin/gh

# GitLab personal/project/access token for GitLab and self-hosted GitLab remotes.
# Put it here when Herdr runs as a service and does not inherit your shell environment.
# GITLAB_TOKEN=glpat-example

# Optional GitLab API root. Default: https://<remote-host>/api/v4.
# WORKTREES_GITLAB_API_URL=https://gitlab.example.com/api/v4

# Set to `plain` if your font lacks Nerd Font glyphs (PR and comment icons).
# WORKTREES_ICONS=plain
